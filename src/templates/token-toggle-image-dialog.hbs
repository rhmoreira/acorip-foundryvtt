<form>
    <div class="form-group">
        {{#each files}}
            <label>
                <input class="rhm-radio" type="radio" value="{{this}}" name="image">
                <img class="rhm-img" src="{{this}}" width="110" height="130">
            </label>
        {{/each}}
    </div>
    <button type="submit" data-action="confirm">{{localize 'acorip.labels.select-button'}}</button>
</form>