<form>
    <div class="form-group">
        {{#each files}}
            <label>
                <input class="rhm-radio" type="radio" value="{{this}}" name="image">
                <img class="rhm-img" src="{{this}}" width="110" height="130">
            </label>
        {{/each}}
    </div>
    <div class="form-group">
        <label for="defaultGear">
            <input id="defaultGear" type="checkbox" class="rhm-checkbox" name="defaultGear">
            {{localize 'acorip.messages.token.default-weapon-image'}}
        </label>
    </div>    
    <button type="submit" data-action="confirm">{{localize 'acorip.labels.confirm'}}</button>
</form>